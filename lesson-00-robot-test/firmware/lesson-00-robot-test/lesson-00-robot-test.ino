#include "robot-test.h"

void setup() {
  pinMode(IN1, OUTPUT);  // настраиваем пины управления моторами как выходы
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  pinMode(TRIG, OUTPUT);  // TRIG — запускаем измерение
  pinMode(ECHO, INPUT);   // ECHO — принимаем импульс эха

  Serial.begin(9600);  // задаем скорость обмена с монитором порта

  wheelsTest();          // TODO 1: сверьте названия колес и направления вращения с выводом в порт.
  // startTest();           // TODO 2: запишите ШИМ, при котором трогается каждое колесо.
  // driveTest(150, 2000);  // TODO 3: проверьте на треке, куда уводит робота и сколько он докатывается.
}

void loop() {
  static uint32_t lastTime = 0;
  if (millis() - lastTime >= 100) {  // раз в 100 мс, не останавливая программу
    lastTime = millis();
